PORT=8081

# Go/pgx DSN (NOT a Java JDBC URL)
DATABASE_URL=postgres://kamis:kamis@localhost:5432/kamis_asset?sslmode=disable

# base64 X509 public key — the pair to profile's JWT_SECRET_KEY. This service
# only verifies tokens, so it never sees the private key.
JWT_PUBLIC_KEY=

# During a key rotation, set JWT_PUBLIC_KEYS instead: a comma-separated list,
# current key first. Tokens signed with any of them verify, so the old and new
# keys never have to be swapped in the same instant across every service. Drop
# the old key once the longest-lived token has expired.
# JWT_PUBLIC_KEYS=<new>,<old>

FRONTEND_URL=http://localhost:5173

# Base URL of the finance service, written to when a maintenance job is booked.
# Unset disables the call: it fails and is logged, and the maintenance record is
# still the source of truth.
FINANCE_URL=http://localhost:8082/api

# Asset photos. Set GCS_BUCKET in deployment; leaving it unset stores them in
# FILE_UPLOAD_DIR instead, so the service runs locally with no Google
# credentials. On a GCE VM, credentials come from the instance metadata server —
# there is no key file to deploy.
GCS_BUCKET=
FILE_UPLOAD_DIR=asset-images
