PORT=8084

# Go/pgx DSN (NOT a Java JDBC URL)
DATABASE_URL=postgres://kamis:kamis@localhost:5432/kamis_purchase?sslmode=disable

# base64 X509 public key — the pair to profile's JWT_SECRET_KEY. This service
# only verifies tokens, so it never sees the private key.
JWT_PUBLIC_KEY=

FRONTEND_URL=http://localhost:5173

# Services purchase calls. Unset disables that dependency: the call fails and is
# logged rather than failing the request.
#   profile  — resolves supplier names, and is told which purchases a supplier has
#   resource — validates catalogue items, and is credited stock on completion
PROFILE_URL=http://localhost:8080/api
RESOURCE_URL=http://localhost:8085/api

# Set in slice 2, when staged-asset photos and the completion handoff land:
# ASSET_URL=http://localhost:8081/api
# FINANCE_URL=http://localhost:8082/api
# GCS_BUCKET=
# FILE_UPLOAD_DIR=purchase-images
