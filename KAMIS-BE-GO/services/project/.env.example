PORT=8083

# Go/pgx DSN (NOT a Java JDBC URL)
DATABASE_URL=postgres://kamis:kamis@localhost:5432/kamis_project?sslmode=disable

# base64 X509 public key — the pair to profile's JWT_SECRET_KEY. This service
# only verifies tokens, so it never sees the private key.
JWT_PUBLIC_KEY=

FRONTEND_URL=http://localhost:5173

# Services project calls.
#   profile  — resolves the client a project belongs to
#   resource — prices catalogue items and holds their stock
#   asset    — validates vehicles and owns their reservations
#   finance  — receives the income when a project is paid
PROFILE_URL=http://localhost:8080/api
RESOURCE_URL=http://localhost:8085/api
ASSET_URL=http://localhost:8081/api
FINANCE_URL=http://localhost:8082/api
