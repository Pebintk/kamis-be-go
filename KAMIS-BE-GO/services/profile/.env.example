PORT=8080

# Go/pgx DSN (NOT a Java JDBC URL)
DATABASE_URL=postgres://kamis:kamis@localhost:5432/kamis_profile?sslmode=disable

# RSA keypair — profile is the issuer, so it needs BOTH (same values as legacy):
JWT_SECRET_KEY=          # base64 PKCS8 private key
JWT_PUBLIC_KEY=          # base64 X509 public key
# Access-token lifetime. Short on purpose: every service verifies a token
# locally with no callback here, so this window is how long a logout has not yet
# taken effect. 15 minutes.
JWT_EXPIRATION_MS=900000

# Refresh-token lifetime. Revoking one is what a real logout does. 7 days.
REFRESH_EXPIRATION_MS=604800000

# Seed admin account, created on first start if the email does not exist
ADMIN_EMAIL=admin@karina.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

FRONTEND_URL=http://localhost:5173

# Base URLs of the services the client/supplier flows call. In Docker these are
# http://<service>-service:<port>/api; the paths in the code are appended to
# them verbatim. An unset value disables that dependency: the call fails and is
# treated as "no data", the same way the legacy WebClient errors were swallowed.
PROJECT_URL=http://localhost:8083/api
RESOURCE_URL=http://localhost:8085/api
ASSET_URL=http://localhost:8081/api
PURCHASE_URL=http://localhost:8084/api
