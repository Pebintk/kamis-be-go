PORT=8082

# Go/pgx DSN (NOT a Java JDBC URL)
DATABASE_URL=postgres://kamis:kamis@localhost:5432/kamis_finance?sslmode=disable

# base64 X509 public key — the pair to profile's JWT_SECRET_KEY. This service
# only verifies tokens, so it never sees the private key.
JWT_PUBLIC_KEY=

FRONTEND_URL=http://localhost:5173

# Services the operational report reads activity charts from. The ledger itself
# needs nothing external: project, purchase and asset push entries to it.
PROJECT_URL=http://localhost:8083/api
PURCHASE_URL=http://localhost:8084/api
